@model IEnumerable<LuxurySalon.Domain.Entities.Appointment>
@{
    ViewData["Title"] = "Manage Appointments";
}

<div class="space-y-8">
    <h1 class="text-4xl font-serif text-salon-gold">Randevu Yönetimi</h1>

    <div class="bg-salon-dark-gray border border-salon-gold/20 rounded-lg overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-salon-black text-salon-gold text-xs uppercase tracking-widest">
                    <tr>
                        <th class="px-6 py-4 font-medium">Tarih & Saat</th>
                        <th class="px-6 py-4 font-medium">Müşteri</th>
                        <th class="px-6 py-4 font-medium">Uzman</th>
                        <th class="px-6 py-4 font-medium">Hizmet</th>
                        <th class="px-6 py-4 font-medium">Durum</th>
                        <th class="px-6 py-4 font-medium text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-salon-gold/5 text-salon-cream">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-salon-gold/5 transition-colors">
                            <td class="px-6 py-4">@item.StartTime.ToString("g")</td>
                            <td class="px-6 py-4 text-sm font-medium">
                                @if (item.Customer != null)
                                {
                                    <div class="flex flex-col">
                                        <span>@item.Customer.FirstName @item.Customer.LastName</span>
                                        <span class="text-[10px] text-salon-gold/50">Müşteri</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col">
                                        <span class="text-salon-gold italic">Misafir</span>
                                        <span class="text-[10px] text-salon-gold/30">@(item.GuestIdentifier?.Substring(0, 8) ?? "Bilinmiyor")</span>
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4">@item.Stylist.FirstName @item.Stylist.LastName</td>
                            <td class="px-6 py-4">@item.Service.Name</td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 rounded-full text-xs @(item.Status.ToString() == "Confirmed" ? "bg-green-900/40 text-green-400" : (item.Status.ToString() == "Cancelled" ? "bg-red-900/40 text-red-400" : "bg-salon-gold/20 text-salon-gold"))">
                                    @(item.Status.ToString() == "Confirmed" ? "Onaylandı" : (item.Status.ToString() == "Cancelled" ? "İptal Edildi" : "Beklemede"))
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                @if (item.Status == LuxurySalon.Domain.Enums.AppointmentStatus.Pending)
                                {
                                    <form asp-action="ChangeStatus" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="Confirmed" />
                                        <button type="submit" class="text-green-400 hover:text-green-300 transition-colors uppercase text-xs tracking-widest">Onayla</button>
                                    </form>
                                }
                                @if (item.Status != LuxurySalon.Domain.Enums.AppointmentStatus.Cancelled)
                                {
                                    <form asp-action="ChangeStatus" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="Cancelled" />
                                        <button type="submit" class="text-red-400 hover:text-red-300 transition-colors uppercase text-xs tracking-widest">İptal Et</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
