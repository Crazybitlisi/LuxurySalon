@{
    ViewData["Title"] = "Galeri";
}

<div class="space-y-16 py-16 px-6 md:px-12">
    <div class="text-center space-y-4 max-w-2xl mx-auto">
        <h1 class="text-5xl font-serif text-salon-gold italic">İlham Veren Dönüşümler</h1>
        <p class="text-salon-cream/60 font-light italic">Sanatımızın en güzel yansımalarını keşfedin.</p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Item 1 -->
        <div class="group relative overflow-hidden aspect-[3/4] border border-salon-gold/10">
            <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 group-hover:scale-110">
            <div class="absolute inset-0 bg-salon-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                <div class="text-center p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-salon-gold font-serif text-xl italic">Balayaj Sanatı</h3>
                    <p class="text-salon-cream/60 text-xs uppercase tracking-widest mt-2">Renklendirme</p>
                </div>
            </div>
        </div>
        
        <!-- Item 2 -->
        <div class="group relative overflow-hidden aspect-[3/4] border border-salon-gold/10">
            <img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 group-hover:scale-110">
            <div class="absolute inset-0 bg-salon-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                <div class="text-center p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-salon-gold font-serif text-xl italic">Modern Kesim</h3>
                    <p class="text-salon-cream/60 text-xs uppercase tracking-widest mt-2">Stil Tasarımı</p>
                </div>
            </div>
        </div>

        <!-- Item 3 -->
        <div class="group relative overflow-hidden aspect-[3/4] border border-salon-gold/10">
            <img src="https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 group-hover:scale-110">
            <div class="absolute inset-0 bg-salon-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                <div class="text-center p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-salon-gold font-serif text-xl italic">Gelin Tasarımı</h3>
                    <p class="text-salon-cream/60 text-xs uppercase tracking-widest mt-2">Özel Gün</p>
                </div>
            </div>
        </div>

        <!-- Item 4 -->
        <div class="group relative overflow-hidden aspect-[3/4] border border-salon-gold/10">
            <img src="https://images.unsplash.com/photo-1516975080664-ed2fc6a32937?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 group-hover:scale-110">
            <div class="absolute inset-0 bg-salon-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                <div class="text-center p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-salon-gold font-serif text-xl italic">Premium Bakım</h3>
                    <p class="text-salon-cream/60 text-xs uppercase tracking-widest mt-2">Keratin Terapi</p>
                </div>
            </div>
        </div>

        <!-- Item 5 -->
        <div class="group relative overflow-hidden aspect-[3/4] border border-salon-gold/10">
            <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 group-hover:scale-110">
            <div class="absolute inset-0 bg-salon-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                <div class="text-center p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-salon-gold font-serif text-xl italic">Erkek Stil</h3>
                    <p class="text-salon-cream/60 text-xs uppercase tracking-widest mt-2">Premium Tıraş</p>
                </div>
            </div>
        </div>

        <!-- Item 6 -->
        <div class="group relative overflow-hidden aspect-[3/4] border border-salon-gold/10">
            <img src="https://images.unsplash.com/photo-1559599101-f09722fb4948?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 group-hover:scale-110">
            <div class="absolute inset-0 bg-salon-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                <div class="text-center p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-salon-gold font-serif text-xl italic">Sıra Dışı Stiller</h3>
                    <p class="text-salon-cream/60 text-xs uppercase tracking-widest mt-2">Özel Defile</p>
                </div>
            </div>
        </div>
    </div>
</div>
