@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="space-y-24 py-16">
    <!-- Hero Section -->
    <div class="text-center space-y-6 max-w-4xl mx-auto px-6">
        <h2 class="text-salon-gold uppercase tracking-[0.3em] text-sm font-light">Mirasımız</h2>
        <h1 class="text-6xl md:text-8xl font-serif italic text-white leading-tight">Güzelliğin En Saf<br>Haliyle Tanışın</h1>
        <p class="text-salon-cream/60 text-lg font-light leading-relaxed">
            1998'den bu yana Nişantaşı'nın kalbinde, sadece saç tasarlamıyor; kişiye özel bir sanat icra ediyoruz. 
            Luxury Salon, modern vizyonu klasik zarafetle birleştiren bir güzellik mabedidir.
        </p>
    </div>

    <!-- Story Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center px-6 md:px-24">
        <div class="relative group">
            <div class="absolute -inset-4 border border-salon-gold/20 group-hover:border-salon-gold/40 transition-all duration-700"></div>
            <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&q=80&w=1000" alt="Salon Interior" class="relative z-10 grayscale hover:grayscale-0 transition-all duration-1000 shadow-2xl">
        </div>
        <div class="space-y-8">
            <h3 class="text-3xl font-serif text-salon-gold italic">Felsefemiz</h3>
            <div class="space-y-6 text-salon-cream/70 font-light leading-relaxed">
                <p>
                    Bizim için her misafir, üzerine titizlikle çalışılması gereken benzersiz bir sanat eseridir. 
                    Kullandığımız her ürün, dünya çapında kalitesi tescillenmiş markaların en seçkin serilerinden oluşur.
                </p>
                <p>
                    Eğitimli stilistlerimiz, global trendleri takip ederken sizin doğal güzelliğinizi ve yaşam tarzınızı merkeze alır. 
                    Çünkü lüks, sadece görünüşte değil; kendinizi nasıl hissettiğinizdedir.
                </p>
            </div>
            <div class="pt-8 grid grid-cols-2 gap-8 border-t border-salon-gold/10">
                <div>
                    <div class="text-3xl font-serif text-salon-gold">25+</div>
                    <div class="text-[10px] uppercase tracking-widest text-salon-cream/40">Yıllık Tecrübe</div>
                </div>
                <div>
                    <div class="text-3xl font-serif text-salon-gold">15k+</div>
                    <div class="text-[10px] uppercase tracking-widest text-salon-cream/40">Mutlu Misafir</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Values Section -->
    <div class="bg-salon-dark-gray/30 py-24 px-6 md:px-24 border-y border-salon-gold/5">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-16 text-center">
            <div class="space-y-4">
                <div class="text-salon-gold text-4xl font-serif italic mb-6">01</div>
                <h4 class="text-xl font-serif text-white">Mükemmeliyet</h4>
                <p class="text-sm text-salon-cream/50 leading-relaxed font-light">Her detayda kusursuzluğu arıyor, asla daha azıyla yetinmiyoruz.</p>
            </div>
            <div class="space-y-4">
                <div class="text-salon-gold text-4xl font-serif italic mb-6">02</div>
                <h4 class="text-xl font-serif text-white">İnovasyon</h4>
                <p class="text-sm text-salon-cream/50 leading-relaxed font-light">En yeni teknikleri ve teknolojileri sanatımızla harmanlıyoruz.</p>
            </div>
            <div class="space-y-4">
                <div class="text-salon-gold text-4xl font-serif italic mb-6">03</div>
                <h4 class="text-xl font-serif text-white">Ayrıcalık</h4>
                <p class="text-sm text-salon-cream/50 leading-relaxed font-light">Size özel zaman dilimlerinde, sadece size odaklanan bir hizmet sunuyoruz.</p>
            </div>
        </div>
    </div>
</div>
