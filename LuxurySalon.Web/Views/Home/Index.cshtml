@{
    ViewData["Title"] = "Güzellikte Ustalık";
}

<div class="relative h-screen flex items-center justify-center overflow-hidden">
    <!-- Hero Background Image -->
    <div class="absolute inset-0 bg-gradient-to-r from-salon-black via-transparent to-salon-black z-10"></div>
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1560066914-1f29c2cc70a2?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center grayscale scale-105 opacity-50"></div>

    <div class="relative z-20 text-center px-6">
        <h2 class="text-salon-gold uppercase tracking-[0.5em] text-sm mb-6 animate-pulse">Eşsiz Tasarımlar</h2>
        <h1 class="text-5xl md:text-8xl font-serif italic mb-8 tracking-tight font-extralight text-salon-cream">
            Lüksü <span class="text-salon-gold">Yeniden Tanımlayın</span>
        </h1>
        <p class="max-w-2xl mx-auto text-salon-cream/60 font-light text-lg mb-12 leading-relaxed italic">
            "Seçkin bireyler için tasarlanmış bir atmosferde, saç bakımının en üst noktasını deneyimleyin."
        </p>
        <div class="flex flex-col md:flex-row gap-6 justify-center items-center">
            <a asp-controller="Booking" asp-action="Index" class="bg-salon-gold text-salon-black px-10 py-4 font-bold uppercase text-xs tracking-[0.3em] hover:bg-salon-cream transition-all duration-500 shadow-2xl shadow-salon-gold/20">
                Randevu Oluştur
            </a>
            <a asp-area="" asp-controller="Home" asp-action="Gallery" class="text-salon-cream border-b border-salon-gold/50 px-4 py-2 text-xs uppercase tracking-widest hover:text-salon-gold transition-colors duration-300">
                Galeriye Göz At
            </a>
        </div>
    </div>
</div>

<section class="py-32 px-6 md:px-12 bg-salon-cream text-salon-black">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-24 items-center">
        <div>
            <h3 class="text-salon-gold uppercase tracking-widest text-xs mb-4">Felsefemiz</h3>
            <h2 class="text-4xl md:text-6xl font-serif mb-8 leading-tight">Form ve Dokunun <br>Kusursuz Uyumu</h2>
            <p class="text-gray-600 font-light leading-relaxed mb-8">
                Her saç teli bir hikaye anlatır. Luxury Salon'da saçı sanatsal bir ifade aracı olarak görüyor, hassas teknik beceriyi içgüdüsel bir güzellik anlayışıyla harmanlıyoruz.
            </p>
            <div class="border-l-4 border-salon-gold pl-6 italic text-gray-500 font-light">
                "Biz sadece saç kesmiyoruz; özgüveni şekillendiriyoruz."
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div class="bg-gray-100 aspect-[3/4] overflow-hidden translate-y-12 rounded-lg">
                <img src="https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Salon İç Mekan" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500">
            </div>
            <div class="bg-gray-100 aspect-[3/4] overflow-hidden rounded-lg">
                <img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Stil Tasarımı" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500">
            </div>
        </div>
    </div>
</section>

