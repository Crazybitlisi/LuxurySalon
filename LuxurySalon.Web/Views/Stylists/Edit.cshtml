@model LuxurySalon.Domain.Entities.Stylist
@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Uzmanı Düzenle" : "Yeni Uzman Ekle";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-12">
        <h1 class="text-4xl font-serif text-salon-gold">@ViewData["Title"]</h1>
        <p class="text-salon-cream/60 mt-2">Salondaki sanatkarların özelliklerini ve çalışma saatlerini yönetin.</p>
    </div>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="space-y-8 bg-salon-dark-gray border border-salon-gold/20 p-8 rounded-lg shadow-2xl">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm italic"></div>
        
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-2">
                <label asp-for="FirstName" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Ad</label>
                <input asp-for="FirstName" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="FirstName" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="LastName" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Soyad</label>
                <input asp-for="LastName" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="LastName" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="ImageUrl" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Profil Resmi URL</label>
                <input asp-for="ImageUrl" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" placeholder="uzman.jpg" />
                <span asp-validation-for="ImageUrl" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="flex items-center space-x-4 pt-6">
                <input asp-for="IsActive" type="checkbox" class="w-5 h-5 accent-salon-gold bg-salon-black border-salon-gold/30 rounded" />
                <label asp-for="IsActive" class="text-salon-cream uppercase tracking-widest text-xs">Aktif</label>
            </div>

            <div class="space-y-2">
                <label asp-for="WorkStartTime" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Mesai Başlangıç</label>
                <input asp-for="WorkStartTime" type="time" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="WorkStartTime" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="WorkEndTime" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Mesai Bitiş</label>
                <input asp-for="WorkEndTime" type="time" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="WorkEndTime" class="text-red-400 text-xs italic"></span>
            </div>
        </div>

        <div class="space-y-2">
            <label asp-for="Bio" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Biyografi</label>
            <textarea asp-for="Bio" rows="4" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" placeholder="Uzmanın uzmanlık alanlarından ve deneyiminden bahsedin..."></textarea>
            <span asp-validation-for="Bio" class="text-red-400 text-xs italic"></span>
        </div>

        <div class="flex justify-between items-center pt-8 border-t border-salon-gold/10">
            <a asp-action="Index" class="text-salon-cream/60 hover:text-salon-cream transition-colors uppercase tracking-widest text-xs">Listeye Dön</a>
            <button type="submit" class="bg-salon-gold hover:bg-salon-gold/80 text-salon-black px-10 py-3 rounded font-bold transition-all uppercase tracking-widest text-sm shadow-xl">
                @(isEdit ? "Uzmanı Güncelle" : "Uzman Ekle")
            </button>
        </div>
    </form>
</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
