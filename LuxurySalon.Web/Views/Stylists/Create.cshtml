@model LuxurySalon.Domain.Entities.Stylist
@{
    ViewData["Title"] = (Model?.Id > 0 ? "Edit" : "Create") + " Stylist";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-12">
        <h1 class="text-4xl font-serif text-salon-gold">@ViewData["Title"]</h1>
        <p class="text-salon-cream/60 mt-2">Manage properties and schedules of the artisans in the salon.</p>
    </div>

    <form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")" method="post" class="space-y-8 bg-salon-dark-gray border border-salon-gold/20 p-8 rounded-lg shadow-2xl">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm italic"></div>
        
        @if (Model?.Id > 0)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-2">
                <label asp-for="FirstName" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">First Name</label>
                <input asp-for="FirstName" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="FirstName" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="LastName" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Last Name</label>
                <input asp-for="LastName" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="LastName" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="ImageUrl" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Profile Image URL</label>
                <input asp-for="ImageUrl" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" placeholder="stylist.jpg" />
                <span asp-validation-for="ImageUrl" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="flex items-center space-x-4 pt-6">
                <input asp-for="IsActive" type="checkbox" class="w-5 h-5 accent-salon-gold bg-salon-black border-salon-gold/30 rounded" />
                <label asp-for="IsActive" class="text-salon-cream uppercase tracking-widest text-xs">Is Active</label>
            </div>

            <div class="space-y-2">
                <label asp-for="WorkStartTime" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Work Start Time</label>
                <input asp-for="WorkStartTime" type="time" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="WorkStartTime" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="WorkEndTime" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Work End Time</label>
                <input asp-for="WorkEndTime" type="time" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="WorkEndTime" class="text-red-400 text-xs italic"></span>
            </div>
        </div>

        <div class="space-y-2">
            <label asp-for="Bio" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Bio</label>
            <textarea asp-for="Bio" rows="4" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" placeholder="Tell us about the stylist's expertise..."></textarea>
            <span asp-validation-for="Bio" class="text-red-400 text-xs italic"></span>
        </div>

        <div class="flex justify-between items-center pt-8 border-t border-salon-gold/10">
            <a asp-action="Index" class="text-salon-cream/60 hover:text-salon-cream transition-colors uppercase tracking-widest text-xs">Back to List</a>
            <button type="submit" class="bg-salon-gold hover:bg-salon-gold/80 text-salon-black px-10 py-3 rounded font-bold transition-all uppercase tracking-widest text-sm shadow-xl">
                @(Model?.Id > 0 ? "Update" : "Create") Stylist
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
