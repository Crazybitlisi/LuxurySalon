@model LuxurySalon.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Admin Girişi";
    Layout = "_Layout";
}

<div class="min-h-[70vh] flex items-center justify-center px-6">
    <div class="max-w-md w-full bg-salon-dark-gray/50 backdrop-blur-xl border border-salon-gold/20 p-12 rounded-lg shadow-2xl">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-serif italic text-salon-gold mb-2">Yönetim Paneli</h1>
            <p class="text-salon-cream/50 text-xs uppercase tracking-[0.2em] font-light">Lütfen Kimliğinizi Doğrulayın</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs italic bg-red-400/10 p-3 rounded border border-red-400/20"></div>

            <div class="space-y-1">
                <label asp-for="Username" class="text-[10px] uppercase tracking-widest text-salon-gold/70 font-bold ml-1"></label>
                <input asp-for="Username" class="w-full bg-salon-black/50 border border-salon-gold/20 rounded px-4 py-3 text-sm focus:outline-none focus:border-salon-gold transition-colors text-white placeholder-white/20" placeholder="admin" />
                <span asp-validation-for="Username" class="text-red-400 text-[10px] italic"></span>
            </div>

            <div class="space-y-1">
                <label asp-for="Password" class="text-[10px] uppercase tracking-widest text-salon-gold/70 font-bold ml-1"></label>
                <input asp-for="Password" class="w-full bg-salon-black/50 border border-salon-gold/20 rounded px-4 py-3 text-sm focus:outline-none focus:border-salon-gold transition-colors text-white placeholder-white/20" placeholder="••••" />
                <span asp-validation-for="Password" class="text-red-400 text-[10px] italic"></span>
            </div>

            <div class="flex items-center space-x-2 pt-2">
                <input asp-for="RememberMe" class="w-4 h-4 rounded border-salon-gold/20 bg-salon-black text-salon-gold focus:ring-salon-gold" />
                <label asp-for="RememberMe" class="text-xs text-salon-cream/60 font-light"></label>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full bg-salon-gold hover:bg-salon-gold/80 text-salon-black py-4 rounded font-bold uppercase tracking-[0.3em] transition-all transform hover:scale-[1.02] active:scale-95 shadow-lg">Giriş Yap</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
