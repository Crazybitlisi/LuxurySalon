@model LuxurySalon.Domain.Entities.Service
@{
    ViewData["Title"] = (Model?.Id > 0 ? "Edit" : "Create") + " Service";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-12">
        <h1 class="text-4xl font-serif text-salon-gold">@ViewData["Title"]</h1>
        <p class="text-salon-cream/60 mt-2">Define the details of the luxury service offered at the salon.</p>
    </div>

    <form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")" method="post" class="space-y-8 bg-salon-dark-gray border border-salon-gold/20 p-8 rounded-lg shadow-2xl">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm italic"></div>
        
        @if (Model?.Id > 0)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-2">
                <label asp-for="Name" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Service Name</label>
                <input asp-for="Name" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" placeholder="e.g., Signature Blowout" />
                <span asp-validation-for="Name" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Price" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Price ($)</label>
                <input asp-for="Price" type="number" step="0.01" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="Price" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="DurationInMinutes" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Duration (Minutes)</label>
                <input asp-for="DurationInMinutes" type="number" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" />
                <span asp-validation-for="DurationInMinutes" class="text-red-400 text-xs italic"></span>
            </div>

            <div class="flex items-center space-x-4 pt-6">
                <input asp-for="IsActive" type="checkbox" class="w-5 h-5 accent-salon-gold bg-salon-black border-salon-gold/30 rounded" />
                <label asp-for="IsActive" class="text-salon-cream uppercase tracking-widest text-xs">Is Active & Visible</label>
            </div>
        </div>

        <div class="space-y-2">
            <label asp-for="Description" class="block text-salon-gold uppercase tracking-widest text-xs font-bold">Description</label>
            <textarea asp-for="Description" rows="4" class="w-full bg-salon-black border border-salon-gold/30 rounded px-4 py-3 text-salon-cream focus:border-salon-gold outline-none transition-all" placeholder="Describe the premium experience..."></textarea>
            <span asp-validation-for="Description" class="text-red-400 text-xs italic"></span>
        </div>

        <div class="flex justify-between items-center pt-8 border-t border-salon-gold/10">
            <a asp-action="Index" class="text-salon-cream/60 hover:text-salon-cream transition-colors uppercase tracking-widest text-xs">Back to List</a>
            <button type="submit" class="bg-salon-gold hover:bg-salon-gold/80 text-salon-black px-10 py-3 rounded font-bold transition-all uppercase tracking-widest text-sm shadow-xl">
                @(Model?.Id > 0 ? "Update" : "Create") Service
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
