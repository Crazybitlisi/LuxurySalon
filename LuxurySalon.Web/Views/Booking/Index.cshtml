@model IEnumerable<LuxurySalon.Domain.Entities.Service>
@{
    ViewData["Title"] = "Randevu Al";
}

<div class="max-w-6xl mx-auto px-4 py-12">
    @Html.AntiForgeryToken()
    <div class="text-center mb-16">
        <h1 class="text-5xl font-serif text-salon-gold mb-4">Ayrıcalıklı Deneyiminizi Ayarlayın</h1>
        <p class="text-salon-cream/60 max-w-2xl mx-auto">Luxury Salon'da kendize ayıracağınız o özel anı planlamaya başlayın.</p>
    </div>

    <!-- Step Progress Indicator -->
    <div class="max-w-3xl mx-auto mb-20 relative px-4">
        <div class="absolute top-5 left-0 w-full h-0.5 bg-salon-gold/20 -z-10"></div>
        <div id="progress-bar" class="absolute top-5 left-0 w-0 h-0.5 bg-salon-gold transition-all duration-500 -z-10"></div>
        
        <div class="flex justify-between items-start">
            <div class="step-indicator active flex flex-col items-center group" data-step="1">
                <div class="w-10 h-10 rounded-full bg-salon-black border-2 border-salon-gold flex items-center justify-center text-salon-gold font-bold transition-all mb-3 shadow-lg group-[.active]:shadow-salon-gold/20">1</div>
                <span class="text-[10px] md:text-xs uppercase tracking-widest text-salon-gold font-medium text-center">Hizmet</span>
            </div>
            <div class="step-indicator flex flex-col items-center group" data-step="2">
                <div class="w-10 h-10 rounded-full bg-salon-black border-2 border-salon-gold/20 flex items-center justify-center text-salon-cream/40 font-bold transition-all mb-3">2</div>
                <span class="text-[10px] md:text-xs uppercase tracking-widest text-salon-cream/40 font-medium text-center">Uzman</span>
            </div>
            <div class="step-indicator flex flex-col items-center group" data-step="3">
                <div class="w-10 h-10 rounded-full bg-salon-black border-2 border-salon-gold/20 flex items-center justify-center text-salon-cream/40 font-bold transition-all mb-3">3</div>
                <span class="text-[10px] md:text-xs uppercase tracking-widest text-salon-cream/40 font-medium text-center">Zaman</span>
            </div>
            <div class="step-indicator flex flex-col items-center group" data-step="4">
                <div class="w-10 h-10 rounded-full bg-salon-black border-2 border-salon-gold/20 flex items-center justify-center text-salon-cream/40 font-bold transition-all mb-3">4</div>
                <span class="text-[10px] md:text-xs uppercase tracking-widest text-salon-cream/40 font-medium text-center">Onay</span>
            </div>
        </div>
    </div>

    <!-- Step Containers -->
    <div id="booking-container" class="relative min-h-[500px]">
        
        <!-- Step 1: Service Selection -->
        <div id="step-1" class="booking-step active space-y-8 animate-fade-in">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var service in Model)
                {
                    <div class="service-card group bg-salon-dark-gray border border-salon-gold/20 p-8 rounded-lg cursor-pointer hover:border-salon-gold/60 transition-all hover:scale-[1.02]" 
                         onclick="selectService(@service.Id, '@service.Name', @service.Price, @service.DurationInMinutes)">
                        <div class="flex justify-between items-start mb-4">
                            <h3 class="text-2xl font-serif text-salon-gold">@service.Name</h3>
                            <span class="text-salon-cream/80 font-serif">@service.Price.ToString("C")</span>
                        </div>
                        <p class="text-salon-cream/60 mb-6 line-clamp-2">@service.Description</p>
                        <div class="text-xs text-salon-gold/60 uppercase tracking-widest">Süre: @service.DurationInMinutes Dakika</div>
                    </div>
                }
            </div>
        </div>

        <!-- Step 2: Stylist Selection -->
        <div id="step-2" class="booking-step hidden space-y-8 animate-fade-in">
            <div id="stylist-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Dynamically populated -->
            </div>
        </div>

        <!-- Step 3: Date & Slot Selection -->
        <div id="step-3" class="booking-step hidden space-y-8 animate-fade-in">
            <div class="flex flex-col lg:flex-row gap-8">
                <div class="lg:w-1/3">
                    <div class="bg-salon-dark-gray border border-salon-gold/20 p-8 rounded-lg">
                        <h3 class="text-xl font-serif text-salon-gold mb-6">Tarih Seçin</h3>
                        <input type="date" id="appointment-date" 
                               class="w-full bg-salon-black border border-salon-gold/30 rounded p-3 text-salon-cream outline-none focus:border-salon-gold mb-4" 
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" 
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               onchange="loadSlots()"/>
                    </div>
                </div>
                <div class="lg:w-2/3">
                    <div class="bg-salon-dark-gray border border-salon-gold/20 p-8 rounded-lg min-h-[300px]">
                        <h3 class="text-xl font-serif text-salon-gold mb-6">Müsait Saatler</h3>
                        <div id="slot-list" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4">
                            <!-- Dynamically populated -->
                        </div>
                        <div id="slot-loading" class="hidden text-center py-12">
                            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-salon-gold mx-auto"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 4: Summary & Confirmation -->
        <div id="step-4" class="booking-step hidden space-y-8 animate-fade-in">
            <div class="bg-salon-dark-gray border border-salon-gold/20 p-12 rounded-lg max-w-2xl mx-auto shadow-2xl">
                <h3 class="text-3xl font-serif text-salon-gold mb-8 text-center border-b border-salon-gold/10 pb-6">Randevu Özeti</h3>
                
                <div class="space-y-6 text-lg">
                    <div class="flex justify-between border-b border-salon-gold/5 pb-4">
                        <span class="text-salon-cream/40 uppercase text-xs tracking-widest self-center">Hizmet</span>
                        <span id="summary-service" class="text-salon-cream font-serif text-xl"></span>
                    </div>
                    <div class="flex justify-between border-b border-salon-gold/5 pb-4">
                        <span class="text-salon-cream/40 uppercase text-xs tracking-widest self-center">Uzman</span>
                        <span id="summary-stylist" class="text-salon-cream font-serif text-xl"></span>
                    </div>
                    <div class="flex justify-between border-b border-salon-gold/5 pb-4">
                        <span class="text-salon-cream/40 uppercase text-xs tracking-widest self-center">Tarih & Saat</span>
                        <span id="summary-time" class="text-salon-cream font-serif text-xl text-right"></span>
                    </div>
                    <div class="flex justify-between pt-4">
                        <span class="text-salon-gold uppercase text-xs tracking-widest self-center font-bold">Toplam Tutar</span>
                        <span id="summary-price" class="text-salon-gold font-serif text-3xl"></span>
                    </div>
                </div>

                <div class="mt-12 space-y-4">
                    <label class="block text-salon-gold uppercase tracking-widest text-xs font-bold mb-2 text-center">Notlarınız (Opsiyonel)</label>
                    <textarea id="customer-notes" class="w-full bg-salon-black border border-salon-gold/30 rounded p-4 text-salon-cream outline-none focus:border-salon-gold h-24" placeholder="Stilistinize iletmek istediğiniz özel bir ricamız var mı?"></textarea>
                </div>

                <div class="mt-12">
                    <button onclick="confirmBooking()" class="w-full bg-salon-gold hover:bg-salon-gold/80 text-salon-black py-4 rounded font-bold uppercase tracking-widest transition-all shadow-xl hover:scale-[1.02]">Randevuyu Onayla</button>
                </div>
            </div>
        </div>

    </div>

    <!-- Navigation Buttons -->
    <div class="flex justify-between max-w-3xl mx-auto mt-12">
        <button id="prev-btn" onclick="prevStep()" class="hidden text-salon-cream/60 hover:text-salon-cream uppercase tracking-widest text-xs font-bold border-b border-transparent hover:border-salon-cream transition-all">Geri Dön</button>
        <div></div> <!-- Spacer -->
    </div>
</div>

@section Scripts {
    <script>
        let currentStep = 1;
        let bookingData = {
            serviceId: 0,
            serviceName: '',
            price: 0,
            stylistId: 0,
            stylistName: '',
            date: '',
            startTime: '',
            duration: 0
        };

        function updateProgress() {
            const bar = document.getElementById('progress-bar');
            bar.style.width = ((currentStep - 1) / 3 * 100) + '%';

            document.querySelectorAll('.step-indicator').forEach(el => {
                const step = parseInt(el.dataset.step);
                const circle = el.querySelector('div');
                const label = el.querySelector('span');

                if (step <= currentStep) {
                    el.classList.add('active');
                    circle.classList.add('border-salon-gold');
                    circle.classList.remove('border-salon-gold/20', 'text-salon-cream/40');
                    circle.classList.add('text-salon-gold');
                    label.classList.add('text-salon-gold');
                    label.classList.remove('text-salon-cream/40');
                } else {
                    el.classList.remove('active');
                    circle.classList.add('border-salon-gold/20', 'text-salon-cream/40');
                    circle.classList.remove('border-salon-gold', 'text-salon-gold');
                    label.classList.add('text-salon-cream/40');
                    label.classList.remove('text-salon-gold');
                }
            });

            const prevBtn = document.getElementById('prev-btn');
            if (currentStep > 1) prevBtn.classList.remove('hidden');
            else prevBtn.classList.add('hidden');
        }

        function showStep(step) {
            document.querySelectorAll('.booking-step').forEach(el => el.classList.add('hidden'));
            document.getElementById('step-' + step).classList.remove('hidden');
            currentStep = step;
            updateProgress();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function prevStep() {
            if (currentStep > 1) showStep(currentStep - 1);
        }

        async function selectService(id, name, price, duration) {
            console.log('Selecting service:', id, name);
            bookingData.serviceId = id;
            bookingData.serviceName = name;
            bookingData.price = price;
            bookingData.duration = duration;
            
            try {
                // Load stylists for this service
                const response = await fetch(`/Booking/GetStylists?serviceId=${id}`);
                if (!response.ok) throw new Error('Fetch failed');
                const stylists = await response.json();
            
                const list = document.getElementById('stylist-list');
                list.innerHTML = stylists.map(s => `
                    <div class="bg-salon-dark-gray border border-salon-gold/20 p-8 rounded-lg cursor-pointer hover:border-salon-gold/60 transition-all text-center hover:scale-[1.02]" 
                         onclick="selectStylist(${s.id}, '${s.fullName}')">
                        <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-salon-gold/30 mb-4 mx-auto">
                            <img src="/images/${s.imageUrl}" alt="${s.fullName}" class="w-full h-full object-cover" onerror="this.src='https://ui-avatars.com/api/?name=${s.fullName}&background=1a1a1a&color=c5a059'"/>
                        </div>
                        <h3 class="text-xl font-serif text-salon-gold mb-1">${s.fullName}</h3>
                        <p class="text-xs text-salon-cream/40 uppercase tracking-widest mb-4">${s.workStartTime} - ${s.workEndTime}</p>
                        <p class="text-salon-cream/60 text-sm line-clamp-2">${s.bio || ''}</p>
                    </div>
                `).join('');

                showStep(2);
            } catch (error) {
                console.error('Error loading stylists:', error);
                alert('Uzmanlar yüklenirken bir hata oluştu.');
            }
        }

        function selectStylist(id, name) {
            bookingData.stylistId = id;
            bookingData.stylistName = name;
            showStep(3);
            loadSlots();
        }

        async function loadSlots() {
            const date = document.getElementById('appointment-date').value;
            bookingData.date = date;
            
            const list = document.getElementById('slot-list');
            const loading = document.getElementById('slot-loading');
            
            list.innerHTML = '';
            loading.classList.remove('hidden');

            try {
                const response = await fetch(`/Booking/AvailableSlots?stylistId=${bookingData.stylistId}&serviceId=${bookingData.serviceId}&date=${date}`);
                const slots = await response.json();
                
                loading.classList.add('hidden');
                
                if (slots.length === 0) {
                    list.innerHTML = '<div class="col-span-full text-center text-salon-cream/40 py-8 italic">Bu tarih için uygun randevu bulunamadı.</div>';
                    return;
                }

                list.innerHTML = slots.map(s => `
                    <button class="p-3 bg-salon-black border border-salon-gold/30 rounded text-salon-cream hover:bg-salon-gold/20 hover:border-salon-gold transition-all text-sm font-medium"
                            onclick="selectSlot('${s.startTime}')">
                        ${new Date(s.startTime).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}
                    </button>
                `).join('');
            } catch (error) {
                loading.classList.add('hidden');
                list.innerHTML = '<div class="col-span-full text-center text-red-500 py-8">Saatler yüklenirken bir hata oluştu.</div>';
            }
        }

        function selectSlot(startTime) {
            bookingData.startTime = startTime;
            
            // Format summary
            document.getElementById('summary-service').textContent = bookingData.serviceName;
            document.getElementById('summary-stylist').textContent = bookingData.stylistName;
            
            const dateObj = new Date(startTime);
            document.getElementById('summary-time').innerHTML = `
                ${dateObj.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}<br/>
                ${dateObj.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}
            `;
            
            document.getElementById('summary-price').textContent = bookingData.price.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
            
            showStep(4);
        }

        async function confirmBooking() {
            const notes = document.getElementById('customer-notes').value;
            
            const requestData = {
                serviceId: bookingData.serviceId,
                stylistId: bookingData.stylistId,
                startTime: bookingData.startTime,
                customerNotes: notes
            };

            const response = await fetch('/Booking/Book', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(requestData)
            });

            const result = await response.json();

            if (response.ok) {
                // Redirect to a success page or show success message
                document.getElementById('booking-container').innerHTML = `
                    <div class="text-center py-20 animate-fade-in">
                        <div class="w-24 h-24 bg-green-900/40 text-green-400 rounded-full flex items-center justify-center mx-auto mb-8 border border-green-400/30">
                            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <h2 class="text-4xl font-serif text-salon-gold mb-4">Randevunuz Alındı!</h2>
                        <p class="text-salon-cream/60 max-w-lg mx-auto mb-12">Rezervasyonunuz başarıyla oluşturuldu. Sizi salonumuzda ağırlamak için sabırsızlanıyoruz.</p>
                        <a href="/" class="bg-salon-gold text-salon-black px-12 py-3 rounded font-bold uppercase tracking-widest transition-all hover:scale-105 inline-block shadow-2xl">Ana Sayfaya Dön</a>
                    </div>
                `;
                document.getElementById('prev-btn').classList.add('hidden');
                document.getElementById('progress-bar').style.width = '100%';
            } else {
                alert(result.message || 'Bir hata oluştu. Lütfen tekrar deneyin.');
            }
        }
    </script>
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .step-indicator div {
        z-index: 10;
    }
</style>
