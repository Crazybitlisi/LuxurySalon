@model IEnumerable<LuxurySalon.Domain.Entities.Appointment>
@{
    ViewData["Title"] = "Randevularım";
}

<div class="py-20 px-6 md:px-12 max-w-5xl mx-auto min-h-[70vh]">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div>
            <h2 class="text-salon-gold uppercase tracking-[0.3em] text-xs mb-4">Size Özel</h2>
            <h1 class="text-4xl md:text-6xl font-serif italic text-white">Randevularınız</h1>
        </div>
        <a asp-action="Index" class="border border-salon-gold/50 px-8 py-3 text-salon-gold hover:bg-salon-gold hover:text-salon-black transition-all duration-300 uppercase text-[10px] tracking-widest font-bold">
            Yeni Randevu Al
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-24 border border-dashed border-salon-gold/20 rounded-lg bg-salon-dark-gray/20">
            <div class="text-salon-gold/30 mb-6 flex justify-center">
                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
            </div>
            <p class="text-salon-cream/60 font-light text-lg mb-8 italic">"Henüz planlanmış bir randevunuz bulunmamaktadır."</p>
            <a asp-action="Index" class="text-salon-gold border-b border-salon-gold px-2 py-1 uppercase text-xs tracking-widest hover:text-white transition-colors">Keşfetmeye Başla</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6">
            @foreach (var item in Model)
            {
                <div class="bg-salon-dark-gray/40 border border-salon-gold/10 p-8 flex flex-col md:flex-row justify-between items-center gap-8 group hover:border-salon-gold/30 transition-all duration-500 hover:bg-salon-dark-gray/60">
                    <div class="flex items-center gap-8 w-full md:w-auto">
                        <div class="text-center border-r border-salon-gold/10 pr-8">
                            <div class="text-3xl font-serif text-salon-gold italic">@item.StartTime.ToString("dd")</div>
                            <div class="text-[10px] uppercase tracking-widest text-salon-cream/40">@item.StartTime.ToString("MMM yyyy")</div>
                        </div>
                        <div class="space-y-2">
                            <h3 class="text-xl font-serif text-white">@item.Service.Name</h3>
                            <div class="flex items-center gap-3 text-xs text-salon-cream/50 uppercase tracking-widest font-light">
                                <span class="text-salon-gold/60">Stilist:</span>
                                <span>@item.Stylist.FirstName @item.Stylist.LastName</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-12 w-full md:w-auto justify-between md:justify-end">
                        <div class="text-right">
                            <div class="text-salon-gold text-lg font-light">@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</div>
                            <div class="text-[9px] uppercase tracking-[0.2em] text-salon-cream/30 mt-1">Randevu Saati</div>
                        </div>
                        
                        <div class="px-6 py-2 border rounded-full text-[10px] uppercase tracking-widest font-bold
                            @(item.Status.ToString() == "Confirmed" ? "border-green-500/30 text-green-500 bg-green-500/5" : 
                              item.Status.ToString() == "Pending" ? "border-yellow-500/30 text-yellow-500 bg-yellow-500/5" : 
                              "border-red-500/30 text-red-500 bg-red-500/5")">
                            @item.Status.ToString()
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
