<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Luxury Hair Salon</title>
    
    <!-- Google Fonts: Playfair Display for Serifs, Inter for Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@100..900&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN (Development/Foundation) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        salon: {
                            gold: '#C5A059',
                            black: '#0A0A0A',
                            'dark-gray': '#1A1A1A',
                            cream: '#F5F5DC',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/css">
        .font-serif { font-family: 'Playfair Display', serif; }
        .font-sans { font-family: 'Inter', sans-serif; }
        
        /* Reveal Animation Classes */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        
        /* Dark Map Filter */
        .dark-map {
            filter: grayscale(100%) invert(90%) contrast(90%);
        }
    </style>
</head>
<body class="bg-salon-black text-white font-sans selection:bg-salon-gold selection:text-salon-black">
    <header>
        <nav class="border-b border-salon-gold/10 py-4 px-6 md:px-12 flex justify-between items-center bg-salon-black/95 backdrop-blur-md sticky top-0 z-50">
            <div class="text-2xl font-serif italic text-salon-gold tracking-widest uppercase">
                <a asp-area="" asp-controller="Home" asp-action="Index">Luxury Salon</a>
            </div>
            <div class="hidden md:flex space-x-8 text-xs uppercase tracking-widest font-light">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="hover:text-salon-gold transition-colors">Ana Sayfa</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="" asp-controller="Admin" asp-action="Index" class="text-salon-gold border-b border-salon-gold/30 pb-1">Yönetim Paneli</a>
                    <a asp-area="" asp-controller="Services" asp-action="Index" class="hover:text-salon-gold transition-colors">Hizmetler</a>
                    <a asp-area="" asp-controller="Stylists" asp-action="Index" class="hover:text-salon-gold transition-colors">Uzmanlarımız</a>
                    <a asp-area="" asp-controller="Admin" asp-action="Appointments" class="hover:text-salon-gold transition-colors">Randevular</a>
                }
                else
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="hover:text-salon-gold transition-colors">Ana Sayfa</a>
                    <a asp-area="" asp-controller="Home" asp-action="Gallery" class="hover:text-salon-gold transition-colors">Galeri</a>
                    <a asp-area="" asp-controller="Booking" asp-action="MyAppointments" class="text-salon-gold border-b border-salon-gold/30 pb-1">Randevularım</a>
                    <a asp-area="" asp-controller="Home" asp-action="About" class="hover:text-salon-gold transition-colors">Hakkımızda</a>
                }
            </div>
            <div class="flex items-center space-x-6">
                <partial name="_LoginPartial" />
                <a asp-area="" asp-controller="Booking" asp-action="Index" class="hidden md:block border border-salon-gold px-6 py-2 text-salon-gold hover:bg-salon-gold hover:text-salon-black transition-all duration-300 uppercase text-[10px] tracking-widest font-bold">
                    Randevu Al
                </a>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-t border-salon-gold/10 py-12 px-6 md:px-12 mt-20 bg-salon-black">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div>
                <div class="text-xl font-serif italic text-salon-gold mb-4">Luxury Salon</div>
                <p class="text-sm text-salon-cream/60 font-light leading-relaxed">
                    Size özel saç tasarım hizmetlerimizle, kendinizi ayrıcalıklı hissedeceğiniz bir deneyim sunuyoruz.
                </p>
            </div>
            <div>
                <div class="text-sm uppercase tracking-widest text-salon-gold mb-4">Konum</div>
                <p class="text-sm text-salon-cream/50 font-light leading-relaxed mb-4">
                    Elegance Bulvarı No: 123,<br>Nişantaşı, İstanbul
                </p>
                <div class="w-full h-32 rounded-lg overflow-hidden border border-salon-gold/10">
                    <iframe class="w-full h-full dark-map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12037.82060931566!2d28.9850!3d41.0516!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab70876423c21%3A0xe5a3c023d838548!2zTmnFn2FudGHFn8EsIafiSelf!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
            <div>
                <div class="text-sm uppercase tracking-widest text-salon-gold mb-4">Çalışma Saatleri</div>
                <ul class="text-sm text-salon-cream/50 font-light space-y-2">
                    <li>Pzt - Cum: 09:00 - 20:00</li>
                    <li>Cmt: 10:00 - 18:00</li>
                    <li>Paz: Kapalı</li>
                    <li class="pt-4"><a asp-controller="Booking" asp-action="MyAppointments" class="text-salon-gold/60 hover:text-salon-gold text-[10px] uppercase tracking-widest">Randevu Sorgula</a></li>
                </ul>
            </div>
        </div>
        <div class="mt-12 text-center text-[10px] uppercase tracking-widest text-salon-cream/30">
            &copy; 2024 Luxury Hair Salon. Tüm Hakları Saklıdır. 
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <a asp-controller="Account" asp-action="Login" class="opacity-0 hover:opacity-100 transition-opacity ml-2">.</a>
            }
        </div>
    </footer>

    <!-- WhatsApp VIP Concierge -->
    <a href="https://wa.me/905000000000" target="_blank" class="fixed bottom-8 right-8 z-[100] group">
        <div class="absolute -inset-4 bg-salon-gold/20 rounded-full blur-xl group-hover:bg-salon-gold/40 transition-all duration-500 animate-pulse"></div>
        <div class="relative bg-salon-gold p-4 rounded-full shadow-2xl shadow-salon-gold/50 transform group-hover:scale-110 group-hover:-rotate-12 transition-all duration-500 flex items-center justify-center">
            <svg class="w-7 h-7 text-salon-black" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
        </div>
        <div class="absolute right-full mr-4 top-1/2 -translate-y-1/2 whitespace-nowrap bg-salon-gold/10 backdrop-blur-md border border-salon-gold/30 text-salon-gold px-4 py-2 rounded-full text-[10px] uppercase tracking-[0.2em] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
            VIP Destek
        </div>
    </a>

    <script>
        // Scroll Reveal Animation Logic
        const revealElements = () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('section, .reveal').forEach(el => {
                el.classList.add('reveal');
                observer.observe(el);
            });
        };

        document.addEventListener('DOMContentLoaded', revealElements);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
