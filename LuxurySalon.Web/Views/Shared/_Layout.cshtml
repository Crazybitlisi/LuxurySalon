<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Luxury Hair Salon</title>
    
    <!-- Google Fonts: Playfair Display for Serifs, Inter for Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@100..900&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN (Development/Foundation) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        salon: {
                            gold: '#C5A059',
                            black: '#0A0A0A',
                            'dark-gray': '#1A1A1A',
                            cream: '#F5F5DC',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/css">
        .font-serif { font-family: 'Playfair Display', serif; }
        .font-sans { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-salon-black text-white font-sans selection:bg-salon-gold selection:text-salon-black">
    <header>
        <nav class="border-b border-salon-gold/10 py-4 px-6 md:px-12 flex justify-between items-center bg-salon-black/95 backdrop-blur-md sticky top-0 z-50">
            <div class="text-2xl font-serif italic text-salon-gold tracking-widest uppercase">
                <a asp-area="" asp-controller="Home" asp-action="Index">Luxury Salon</a>
            </div>
            <div class="hidden md:flex space-x-8 text-xs uppercase tracking-widest font-light">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="hover:text-salon-gold transition-colors">Ana Sayfa</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="" asp-controller="Admin" asp-action="Index" class="text-salon-gold border-b border-salon-gold/30 pb-1">Yönetim Paneli</a>
                    <a asp-area="" asp-controller="Services" asp-action="Index" class="hover:text-salon-gold transition-colors">Hizmetler</a>
                    <a asp-area="" asp-controller="Stylists" asp-action="Index" class="hover:text-salon-gold transition-colors">Uzmanlarımız</a>
                    <a asp-area="" asp-controller="Admin" asp-action="Appointments" class="hover:text-salon-gold transition-colors">Randevular</a>
                }
                else
                {
                    <a asp-area="" asp-controller="Services" asp-action="Index" class="hover:text-salon-gold transition-colors">Hizmetlerimiz</a>
                    <a asp-area="" asp-controller="Stylists" asp-action="Index" class="hover:text-salon-gold transition-colors">Uzmanlarımız</a>
                    <a asp-area="" asp-controller="Home" asp-action="Gallery" class="hover:text-salon-gold transition-colors">Galeri</a>
                    <a asp-area="" asp-controller="Home" asp-action="About" class="hover:text-salon-gold transition-colors">Hakkımızda</a>
                }
            </div>
            <div class="flex items-center space-x-6">
                <partial name="_LoginPartial" />
                <a asp-area="" asp-controller="Booking" asp-action="Index" class="hidden md:block border border-salon-gold px-6 py-2 text-salon-gold hover:bg-salon-gold hover:text-salon-black transition-all duration-300 uppercase text-[10px] tracking-widest font-bold">
                    Randevu Al
                </a>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-t border-salon-gold/10 py-12 px-6 md:px-12 mt-20 bg-salon-black">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div>
                <div class="text-xl font-serif italic text-salon-gold mb-4">Luxury Salon</div>
                <p class="text-sm text-salon-cream/60 font-light leading-relaxed">
                    Size özel saç tasarım hizmetlerimizle, kendinizi ayrıcalıklı hissedeceğiniz bir deneyim sunuyoruz.
                </p>
            </div>
            <div>
                <div class="text-sm uppercase tracking-widest text-salon-gold mb-4">Konum</div>
                <p class="text-sm text-salon-cream/50 font-light leading-relaxed">
                    Elegance Bulvarı No: 123,<br>Nişantaşı, İstanbul
                </p>
            </div>
            <div>
                <div class="text-sm uppercase tracking-widest text-salon-gold mb-4">Çalışma Saatleri</div>
                <ul class="text-sm text-salon-cream/50 font-light space-y-2">
                    <li>Pzt - Cum: 09:00 - 20:00</li>
                    <li>Cmt: 10:00 - 18:00</li>
                    <li>Paz: Kapalı</li>
                </ul>
            </div>
        </div>
        <div class="mt-12 text-center text-[10px] uppercase tracking-widest text-salon-cream/30">
            &copy; 2024 Luxury Hair Salon. Tüm Hakları Saklıdır. 
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <a asp-controller="Account" asp-action="Login" class="opacity-0 hover:opacity-100 transition-opacity ml-2">.</a>
            }
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
